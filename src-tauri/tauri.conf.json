{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lin Tunnel",
  "version": "1.5.0",
  "identifier": "com.lin.tunnel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lin Tunnel",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/cloudflared.exe": "bin/cloudflared.exe"
    },
    "shortDescription": "把本机服务发布到公网",
    "longDescription": "Lin Tunnel 用 Cloudflare 官方 cloudflared 内核，把任意本机端口映射为 https 公网地址，支持多隧道、暂停/继续/重启、实时日志与线路测速。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
